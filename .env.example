# Server Configuration
PORT=5005
NODE_ENV=production

# Supabase Configuration (Database & Storage)
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Alternative/Anon Key fallback
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT Secret Key for Authentication (Generate a strong 32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_here_2026

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cloudinary (Optional - for high-performance image uploads and CDN hosting)
# Found in your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
