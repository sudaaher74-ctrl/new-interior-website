# Backend Port (Used for local development)
PORT=5005

# MongoDB Connection String (Replace with your Atlas URI for production)
# Example: MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/os-interiors

# JWT Secret Key for Authentication (Generate a strong random string for production)
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 Client ID and Secret (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
